# Use Raspberry Pi3 (32-bit) base imageses for the 64-bit ARM devices
FROM balenalib/raspberrypi3-debian:stretch@sha256:f340aa0ff79edb97984f911d7a7479831cbca166a14c4c4601a66366d02907e7

WORKDIR /app

RUN install_packages \
      wget omxplayer stress \
      python3 python3-matplotlib python3-pip python3-setuptools python3-tk

COPY requirements.txt ./
RUN pip3 install -r requirements.txt

COPY *.sh ./
COPY server.py ./

CMD ["bash", "start.sh"]
